# Django API base URL (include the /api prefix). In production behind
# CloudFront this can be the same origin, e.g. https://<distribution>/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Amazon Cognito managed login (public values only, never a client secret) ---
# Cognito domain, e.g. https://<prefix>.auth.<region>.amazoncognito.com or a custom domain
VITE_COGNITO_DOMAIN=
# Public app client ID (app client must have NO client secret)
VITE_COGNITO_CLIENT_ID=
# Optional. Defaults to <current origin>/auth/callback and <current origin>/
# Must exactly match the Allowed callback / sign-out URLs on the app client.
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_LOGOUT_URI=
# Optional. Defaults shown.
VITE_COGNITO_SCOPES=openid email profile
VITE_COGNITO_GOOGLE_PROVIDER=Google

# Dev only: lets the profile page call protected endpoints until real auth lands.
# Put the real value in .env.local (git-ignored), not here.
# VITE_DEV_BASIC_AUTH=username:password