
# Django
DJANGO_SECRET_KEY=replace-with-your-own-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=postgresql
DB_NAME=recipe_app
DB_USER=recipe_user
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=5432

# PostgreSQL TLS configuration
DB_SSLMODE=prefer
DB_SSL_ROOT_CERT=

MEDIA_STORAGE_BACKEND=s3
AWS_MEDIA_BUCKET_NAME=recipe-app-media-mediabucket-w0ts6zix1yiu
AWS_MEDIA_CLOUDFRONT_DOMAIN=<your-cloudfront-domain>
AWS_REGION=us-east-1


# Amazon Cognito sign-in
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_IDS=

# Local development only: also accept Django username/password logins
# (frontend VITE_DEV_BASIC_AUTH). Ignored unless DJANGO_DEBUG=True. Never True in production.
DJANGO_DEV_BASIC_AUTH=False